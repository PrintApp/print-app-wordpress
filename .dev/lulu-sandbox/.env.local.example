# Copy to .env.local and fill in. .env.local is git-ignored.

# From https://developers.sandbox.lulu.com/user-profile/api-keys (sandbox, not production)
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=

# The Lulu product to print and the interior page count. Defaults: a 6 x 9 in
# coil-bound notebook, black and white, 100 pages.
LULU_POD_PACKAGE_ID=0600X0900.BW.STD.CO.060UW444.MXX
LULU_PAGE_COUNT=100

# The Print.App design or project used as the cover in test orders. Leave empty
# until you have one sized to the cover dimensions setup.sh prints.
COVER_PROJECT_ID=
